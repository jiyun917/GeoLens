# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — do not commit real keys.
# Create it BEFORE starting the servers: the pipeline reads these at import time.
#
# Placeholders like `sk-your-api-key-here` and `ghp_your-api-key-here`
# are intentional fakes and will be rejected by vendor APIs. They match
# scripts/secret_scan.py's allowlist so a clean repo scans cleanly.

# --- LLM API keys ---
# Required. Screen reading and reranking (gemini-2.5-flash), the default
# generator and the target-coordinate call (gemini-2.5-pro).
GEMINI_API_KEY=your-api-key-here

# Optional: Claude Sonnet 4.6 generator (benchmark; desktop fallback) and the
# claude-haiku judge.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: GPT-4o generator (benchmark only). Embeddings are local (bge-m3),
# so no OpenAI key is needed for ingestion.
OPENAI_API_KEY=sk-your-api-key-here

# Optional, legacy: OpenRouter route for the archived Qwen backend.
OPENROUTER_API_KEY=sk-or-your-api-key-here

# --- Knowledge store ---
# ChromaDB directory. The paper's index is ./data/chromadb_v4 (bge-m3);
# ./data/chromadb is the default used by the UI upload path.
CHROMADB_PATH=./data/chromadb_v4
EMBED_MODEL=BAAI/bge-m3
# Which software's graphs are active for routing: opendtect | qgis
GEOLENS_SOFTWARE_ID=opendtect

# --- Optional integrations ---
# GitHub personal access token for cloning private manual repositories.
GITHUB_TOKEN=ghp_your-api-key-here

# --- Frontend ---
# Backend URL consumed by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# --- Benchmark harness ---
# Generator invoked by scripts/run_all_models.py: gemini | claude | gpt
BENCH_MODEL=gemini
