# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — do not commit real keys.
#
# Placeholders like `sk-your-api-key-here` and `ghp_your-api-key-here`
# are intentional fakes and will be rejected by vendor APIs. They match
# scripts/secret_scan.py's allowlist so a clean repo scans cleanly.

# --- LLM API keys ---
# Required for the benchmark (Gemini is the routing/vision default).
GEMINI_API_KEY=your-api-key-here

# Optional: needed only if you benchmark GPT-4o / use OpenAI embeddings.
OPENAI_API_KEY=sk-your-api-key-here

# Optional: needed only if you benchmark Claude Sonnet 4.6.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional: OpenRouter (only if you route Qwen or Gemini via OpenRouter).
OPENROUTER_API_KEY=sk-or-your-api-key-here

# --- Storage ---
# ChromaDB persistent path (default: ./data/chromadb).
CHROMADB_PATH=./data/chromadb

# --- Optional integrations ---
# GitHub personal access token for cloning private manual repositories.
GITHUB_TOKEN=ghp_your-api-key-here

# --- Frontend ---
# Backend URL consumed by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# --- Benchmark harness ---
# Which model backend to invoke from scripts/run_all_models.py.
# One of: gemini | claude | gpt | qwen | gemini_flash.
BENCH_MODEL=gemini
